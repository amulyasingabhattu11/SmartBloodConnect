NODE_ENV=development
DEMO_MODE=false

# Backend
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ruby_blood
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Matching configuration
MATCH_RADIUS_STEPS_KM=5,10,20,30
MATCH_BATCH_SIZE=5
MATCH_EXTRA_CANDIDATES_PER_UNIT=4
MIN_DONATION_INTERVAL_DAYS=56
MATCH_LOCATION_MAX_AGE_MINUTES=60
MATCH_WEIGHT_DISTANCE=0.40
MATCH_WEIGHT_RECENCY=0.30
MATCH_WEIGHT_RELIABILITY=0.20
MATCH_WEIGHT_URGENCY_FIT=0.10

# Amazon SNS donor alerts (R4)
# Set ALERTS_ENABLED=true only in production; leave false for local dev and demo mode.
ALERTS_ENABLED=false
AWS_REGION=ap-south-1
SNS_TOPIC_ARN=

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
